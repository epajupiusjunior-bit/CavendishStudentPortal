@{ 
    ViewData["Title"] = "Login"; 
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ACMIS Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        body {
            background: linear-gradient(135deg, #f8f4f0 0%, #e5e7eb 100%); /* Dirty white → soft grey */
        }
        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }
        .input-focus {
            transition: all 0.3s ease;
        }
        .input-focus:focus {
            border-color: #4E93CC;
            box-shadow: 0 0 0 4px rgba(78, 147, 204, 0.15);
            outline: none;
        }
        .btn-blue {
            background: linear-gradient(to right, #4E93CC, #2563eb);
            transition: all 0.3s ease;
        }
        .btn-blue:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(78, 147, 204, 0.4);
        }
        .logo-container {
            filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center font-sans antialiased">
    <div class="w-full max-w-md mx-auto px-6 py-12">
        <!-- Main Card -->
        <div class="glass rounded-3xl p-10">
            
            <!-- Header -->
            <div class="text-center mb-10">
                <div class="logo-container mb-6">
                    <img src="/images/cavendish-logo.png" 
                         alt="Cavendish University Uganda" 
                         class="h-20 mx-auto">
                </div>
                <h1 class="text-3xl font-semibold text-[#121e38] tracking-tight">
                    CAVENDISH UNIVERSITY UGANDA
                </h1>
                <p class="text-[#4E93CC] text-xl font-medium mt-1">ACMIS Portal</p>
                <p class="text-gray-500 mt-2 text-sm">Sign in to access your student portal</p>
            </div>

            <!-- Form -->
            <form asp-action="Login" method="post" class="space-y-6">
                
                <!-- Username -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Username / Student Number</label>
                    <div class="relative">
                        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fa-solid fa-user"></i>
                        </span>
                        <input 
                            name="username" 
                            placeholder="Enter your username or student number"
                            class="input-focus w-full pl-12 pr-5 py-4 bg-white border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 focus:outline-none text-base"
                            required />
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <div class="relative">
                        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input 
                            name="password" 
                            type="password" 
                            id="password"
                            placeholder="Enter your password"
                            class="input-focus w-full pl-12 pr-12 py-4 bg-white border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 focus:outline-none text-base"
                            required />
                        <button type="button" onclick="togglePassword()" 
                                class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                            <i id="eyeIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember me + Forgot -->
                <div class="flex items-center justify-between text-sm">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input type="checkbox" name="rememberMe" class="w-4 h-4 accent-[#4E93CC] rounded border-gray-300">
                        <span class="text-gray-600">Remember me</span>
                    </label>
                    <a href="#" class="text-[#4E93CC] hover:text-blue-700 font-medium">Forgot password?</a>
                </div>

                <!-- Sign In Button -->
                <button 
                    type="submit"
                    class="btn-blue w-full text-white font-semibold py-4 rounded-2xl text-lg tracking-wide shadow-lg">
                    SIGN IN
                </button>
            </form>

            <!-- Error Message -->
            @if (ViewBag.Error != null)
            {
                <div class="mt-6 text-red-600 text-center bg-red-50 border border-red-100 p-3 rounded-2xl text-sm">
                    @ViewBag.Error
                </div>
            }
        </div>

        <!-- Footer -->
        <p class="text-center text-gray-400 text-xs mt-8">
            © @(DateTime.Now.Year) Cavendish University Uganda • All Rights Reserved
        </p>
    </div>

    <script>
        function togglePassword() {
            const passwordField = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            
            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                eyeIcon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                passwordField.type = 'password';
                eyeIcon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
</body>
</html>