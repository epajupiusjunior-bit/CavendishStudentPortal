@{
    ViewData["Title"] = "Edit Lecturer";
    var lecturer = Model as CavendishACMISPortal.Models.User;
}

<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Lecturer</h2>

    <div class="glass rounded-3xl p-10">
        <form asp-action="EditLecturer" method="post">
            <input type="hidden" name="Id" value="@lecturer?.Id" />

            <div class="grid grid-cols-2 gap-8">
                <div>
                    <label class="block text-sm font-medium mb-2">Full Name</label>
                    <input name="FullName" value="@lecturer?.FullName"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Teacher ID</label>
                    <input name="Username" value="@lecturer?.Username"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Department</label>
                    <input name="Department" value="@lecturer?.Department"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Email</label>
                    <input name="Email" value="@lecturer?.Email" type="email"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Phone Number</label>
                    <input name="Phone" value="@lecturer?.Phone"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" />
                </div>
            </div>

            <div class="flex gap-4 mt-12">
                <button type="submit"
                        class="flex-1 bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700 transition">
                    Save Changes
                </button>
                <a asp-action="Lecturers"
                   class="flex-1 bg-gray-200 text-gray-700 py-5 rounded-3xl font-semibold text-center hover:bg-gray-300 transition">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>