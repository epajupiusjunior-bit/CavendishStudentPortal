@{
    ViewData["Title"] = "Edit Course";
    var course = Model as CavendishACMISPortal.Models.Course;
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Course</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="EditCourse" method="post">
            <input type="hidden" name="Id" value="@course?.Id" />
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Course Code</label>
                <input name="CourseCode" value="@course?.CourseCode" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Course Name</label>
                <input name="CourseName" value="@course?.CourseName" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <button type="submit" class="w-full bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700">
                Save Changes
            </button>
        </form>
    </div>
</div>