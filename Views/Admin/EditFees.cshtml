@{
    ViewData["Title"] = "Edit Fees / Invoice";
    var invoice = Model as CavendishACMISPortal.Models.Invoice;
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Invoice</h2>
    <div class="glass rounded-3xl p-8">
        <form asp-action="EditFees" method="post">
            <input type="hidden" name="Id" value="@invoice?.Id" />
            <div>
                <label class="block text-sm font-medium mb-2">Amount Due</label>
                <input name="Due" value="@invoice?.Due" type="number" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <div class="mt-6">
                <label class="block text-sm font-medium mb-2">Status</label>
                <select name="Status" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]">
                    <option value="Pending" selected="@(invoice?.Status == "Pending")">Pending</option>
                    <option value="Paid" selected="@(invoice?.Status == "Paid")">Paid</option>
                    <option value="Cleared" selected="@(invoice?.Status == "Cleared")">Cleared</option>
                </select>
            </div>
            <button type="submit" class="mt-10 w-full bg-green-600 text-white py-4 rounded-3xl font-semibold">Update Invoice</button>
        </form>
    </div>
</div>