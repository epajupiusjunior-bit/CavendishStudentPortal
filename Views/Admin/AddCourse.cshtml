@{
    ViewData["Title"] = "Add Course";
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Add New Course</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="AddCourse" method="post">
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Course Code</label>
                <input name="CourseCode" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Course Name</label>
                <input name="CourseName" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <button type="submit" class="w-full bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700">
                Create Course
            </button>
        </form>
    </div>
</div>