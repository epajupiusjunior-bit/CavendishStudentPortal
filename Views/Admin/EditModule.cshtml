@{
    ViewData["Title"] = "Edit Module";
    var module = Model as CavendishACMISPortal.Models.Module;
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Module</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="EditModule" method="post">
            <input type="hidden" name="Id" value="@module?.Id" />
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Course</label>
                <select name="CourseId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    @foreach (var c in ViewBag.Courses as List<CavendishACMISPortal.Models.Course> ?? new List<CavendishACMISPortal.Models.Course>())
                    {
                        <option value="@c.Id" selected="@(c.Id == module?.CourseId)">@c.CourseName</option>
                    }
                </select>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Module Code</label>
                <input name="ModuleCode" value="@module?.ModuleCode" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Module Name</label>
                <input name="ModuleName" value="@module?.ModuleName" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Credits</label>
                <input name="Credits" value="@module?.Credits" type="number" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>
            <button type="submit" class="w-full bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700">
                Save Changes
            </button>
        </form>
    </div>
</div>