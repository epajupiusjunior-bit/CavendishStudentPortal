@{
    ViewData["Title"] = "Courses";
    var courses = Model as List<CavendishACMISPortal.Models.Course>;
}
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-semibold">All Courses</h2>
        <a asp-action="AddCourse" class="bg-green-600 text-white px-8 py-4 rounded-3xl hover:bg-green-700">+ Add New Course</a>
    </div>

    <div class="glass rounded-3xl overflow-hidden">
        <table class="w-full">
            <thead class="bg-[#0f172a] text-white">
                <tr>
                    <th class="px-8 py-4 text-left">Course Code</th>
                    <th class="px-8 py-4 text-left">Course Name</th>
                    <th class="px-8 py-4 text-left">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in courses ?? new List<CavendishACMISPortal.Models.Course>())
                {
                    <tr class="border-t hover:bg-gray-50 dark:hover:bg-slate-800">
                        <td class="px-8 py-4 font-medium">@c.CourseCode</td>
                        <td class="px-8 py-4">@c.CourseName</td>
                        <td class="px-8 py-4">
                            <a asp-action="EditCourse" asp-route-id="@c.Id" class="text-blue-600 hover:underline mr-4">Edit</a>
                            <a asp-action="DeleteCourse" asp-route-id="@c.Id"
                               onclick="return confirm('Delete this course?')" class="text-red-600 hover:underline">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>