@{
    ViewData["Title"] = "Add Module";
    var courses = ViewBag.Courses as List<CavendishACMISPortal.Models.Course> ?? new List<CavendishACMISPortal.Models.Course>();
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Add New Module</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="AddModule" method="post">
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Select Course</label>
                <select name="CourseId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    <option value="">-- Select Course --</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.Id">@c.CourseName (@c.CourseCode)</option>
                    }
                </select>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Module Code</label>
                <input name="ModuleCode" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" placeholder="e.g. ART101" required />
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Module Name</label>
                <input name="ModuleName" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" placeholder="Introduction to Fine Arts" required />
            </div>

            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Credits</label>
                <input name="Credits" type="number" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>

            <button type="submit" class="w-full bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700 transition">
                Create Module
            </button>
        </form>
    </div>
</div>