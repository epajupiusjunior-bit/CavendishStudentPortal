@{
    ViewData["Title"] = "Students";
    var students = Model as List<CavendishACMISPortal.Models.User>;
}
<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-semibold">All Students</h2>
        <a asp-action="AddStudent" class="bg-green-600 text-white px-8 py-4 rounded-3xl hover:bg-green-700">+ Add New Student</a>
    </div>

    <div class="glass rounded-3xl overflow-hidden">
        <table class="w-full">
            <thead class="bg-[#0f172a] text-white">
                <tr>
                    <th class="px-8 py-4 text-left">Photo</th>
                    <th class="px-8 py-4 text-left">Name</th>
                    <th class="px-8 py-4 text-left">Student No</th>
                    <th class="px-8 py-4 text-left">Programme</th>
                    <th class="px-8 py-4 text-left">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in students ?? new List<CavendishACMISPortal.Models.User>())
                {
                    <tr class="border-t hover:bg-gray-50 dark:hover:bg-slate-800">
                        <td class="px-8 py-4">
                            @if (!string.IsNullOrEmpty(s.ProfilePicture))
                            {
                                <img src="/images/profiles/@s.ProfilePicture" class="w-10 h-10 rounded-full object-cover" />
                            }
                            else
                            {
                                <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-xl">👤</div>
                            }
                        </td>
                        <td class="px-8 py-4">@s.FullName</td>
                        <td class="px-8 py-4">@s.Username</td>
                        <td class="px-8 py-4">@s.Programme</td>
                        <td class="px-8 py-4">
                            <a asp-action="EditStudent" asp-route-id="@s.Id" class="text-blue-600 hover:underline mr-4">Edit</a>
                            <a asp-action="DeleteStudent" asp-route-id="@s.Id" onclick="return confirm('Delete this student?')" class="text-red-600 hover:underline">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>