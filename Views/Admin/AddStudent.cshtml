@{
    ViewData["Title"] = "Add Student";
}
<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Add New Student</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="AddStudent" method="post" enctype="multipart/form-data">
            <div class="grid grid-cols-2 gap-8">
                <div>
                    <label>Profile Picture</label>
                    <input type="file" name="profilePicture" accept="image/*" class="mt-2" />
                </div>
                <div>
                    <label>Full Name</label>
                    <input name="FullName" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Student Number</label>
                    <input name="Username" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Password</label>
                    <input name="Password" type="password" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Programme</label>
                    <input name="Programme" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Email</label>
                    <input name="Email" type="email" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
                <div>
                    <label>Phone</label>
                    <input name="Phone" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
                <div>
                    <label>District</label>
                    <input name="District" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
            </div>
            <button type="submit" class="mt-10 w-full bg-green-600 text-white py-5 rounded-3xl font-semibold">Register Student</button>
        </form>
    </div>
</div>