@{
    ViewData["Title"] = "Edit Student";
    var student = Model as CavendishACMISPortal.Models.User;
}
<div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Student Profile</h2>
    <div class="glass rounded-3xl p-8">
        <form asp-action="EditStudent" method="post">
            <input type="hidden" name="Id" value="@student?.Id" />
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium mb-2">Full Name</label>
                    <input name="FullName" value="@student?.FullName" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Student Number</label>
                    <input name="Username" value="@student?.Username" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Programme</label>
                    <input name="Programme" value="@student?.Programme" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">District</label>
                    <input name="District" value="@student?.District" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Phone</label>
                    <input name="Phone" value="@student?.Phone" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Email</label>
                    <input name="Email" value="@student?.Email" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" />
                </div>
            </div>
            <div class="flex gap-4 mt-10">
                <button type="submit" class="bg-green-600 text-white px-10 py-4 rounded-3xl font-semibold flex-1">Save Changes</button>
                <a asp-action="Students" class="bg-gray-200 text-gray-700 px-10 py-4 rounded-3xl font-semibold flex-1 text-center">Cancel</a>
            </div>
        </form>
    </div>
</div>