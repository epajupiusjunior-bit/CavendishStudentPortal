@{
    ViewData["Title"] = "Edit Student";
    var student = Model as CavendishACMISPortal.Models.User;
}
<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Edit Student</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="EditStudent" method="post">
            <input type="hidden" name="Id" value="@student?.Id" />
            <div class="grid grid-cols-2 gap-8">
                <div>
                    <label>Full Name</label>
                    <input name="FullName" value="@student?.FullName" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Student Number</label>
                    <input name="Username" value="@student?.Username" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Programme</label>
                    <input name="Programme" value="@student?.Programme" class="w-full px-5 py-4 rounded-2xl border mt-2" required />
                </div>
                <div>
                    <label>Email</label>
                    <input name="Email" value="@student?.Email" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
                <div>
                    <label>Phone</label>
                    <input name="Phone" value="@student?.Phone" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
                <div>
                    <label>District</label>
                    <input name="District" value="@student?.District" class="w-full px-5 py-4 rounded-2xl border mt-2" />
                </div>
            </div>
            <button type="submit" class="mt-10 w-full bg-green-600 text-white py-5 rounded-3xl font-semibold">Save Changes</button>
        </form>
    </div>
</div>