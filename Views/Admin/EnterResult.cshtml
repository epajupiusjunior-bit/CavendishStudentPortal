@{
    ViewData["Title"] = "Enter Result";
}
<div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Enter New Result</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="EnterResult" method="post">
            <div class="grid grid-cols-2 gap-8">
                <div>
                    <label class="block text-sm font-medium mb-2">Student</label>
                    <select name="UserId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                        @foreach (var s in ViewBag.Students as List<CavendishACMISPortal.Models.User> ?? new List<CavendishACMISPortal.Models.User>())
                        {
                            <option value="@s.Id">@s.FullName (@s.Username)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Module</label>
                    <select name="ModuleId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                        @foreach (var m in ViewBag.Modules as List<CavendishACMISPortal.Models.Module> ?? new List<CavendishACMISPortal.Models.Module>())
                        {
                            <option value="@m.Id">@m.ModuleCode - @m.ModuleName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-6 mt-10">
                <div>
                    <label class="block text-sm font-medium mb-2">CAT 1 (20%)</label>
                    <input name="CAT1" type="number" step="0.1" min="0" max="20"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">CAT 2 (20%)</label>
                    <input name="CAT2" type="number" step="0.1" min="0" max="20"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Final Exam (60%)</label>
                    <input name="FinalExam" type="number" step="0.1" min="0" max="60"
                           class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
            </div>

            <button type="submit" class="mt-12 w-full bg-green-600 text-white py-5 rounded-3xl font-semibold text-lg hover:bg-green-700">
                Save Result
            </button>
        </form>
    </div>
</div>