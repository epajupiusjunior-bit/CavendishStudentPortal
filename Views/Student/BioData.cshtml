@{
    ViewData["Title"] = "Bio Data";
    var user = ViewBag.User as CavendishACMISPortal.Models.User;
}
<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">👤 My Bio Data</h2>
    <div class="glass rounded-3xl p-10">
        <div class="grid grid-cols-2 gap-8">
            <div><strong>Full Name:</strong> @user?.FullName</div>
            <div><strong>Student No:</strong> @user?.Username</div>
            <div><strong>Programme:</strong> @user?.Programme</div>
            <div><strong>District:</strong> @user?.District</div>
            <div><strong>Email:</strong> @user?.Email</div>
            <div><strong>Phone:</strong> @user?.Phone</div>
        </div>
    </div>
</div>