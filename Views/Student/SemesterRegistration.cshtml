@{
    ViewData["Title"] = "Semester Registration";
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Semester Registration</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="RegisterSemester" method="post">
            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Academic Year</label>
                <select name="year" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    <option value="2025/2026">2025/2026</option>
                    <option value="2026/2027">2026/2027</option>
                </select>
            </div>
            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Semester</label>
                <select name="semester" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    <option value="Semester I">Semester I</option>
                    <option value="Semester II">Semester II</option>
                </select>
            </div>
            <button type="submit" class="w-full bg-green-600 text-white py-5 rounded-3xl font-semibold">Register Semester</button>
        </form>
    </div>
</div>