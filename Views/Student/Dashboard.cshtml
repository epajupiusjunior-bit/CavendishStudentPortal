@{
    ViewData["Title"] = "Dashboard";
    var user = ViewBag.User as CavendishACMISPortal.Models.User;
}
<div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-semibold">Good morning, @user?.FullName 👋</h1>
    <p class="text-gray-500 mt-1">Welcome to your student portal</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Current Semester</p>
            <p class="text-4xl font-semibold mt-3">Semester II 2025/2026</p>
        </div>
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Academic Status</p>
            <p class="text-4xl font-semibold text-emerald-600 mt-3">Normal Progress</p>
        </div>
    </div>
</div>