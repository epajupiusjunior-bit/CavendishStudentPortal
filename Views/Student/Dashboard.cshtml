@{
    ViewData["Title"] = "Dashboard";
    var student = ViewBag.Student as CavendishACMISPortal.Models.User;
    bool isEnrolled = ViewBag.IsEnrolled ?? false;
    int moduleCount = ViewBag.EnrolledModulesCount ?? 0;
    string currentSemester = ViewBag.CurrentSemester ?? "Not Registered";
    decimal cgpa = ViewBag.CGPA ?? 0.0m;
}

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-start mb-10">
        <div>
            <h1 class="text-5xl font-semibold mt-3">
                Good morning, <span class="text-5xl font-semibold text-indigo-600 mt-3">@student?.FullName</span> 👋
            </h1>
            <p class="text-gray-500 dark:text-gray-400">Student No: @student?.Username</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
        <!-- Academic Status -->
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Academic Status</p>
            @if (isEnrolled)
            {
                <p class="text-4xl font-semibold text-emerald-600 mt-3">Normal Progress</p>
            }
            else
            {
                <p class="text-4xl font-semibold text-amber-600 mt-3">Not Enrolled</p>
            }
        </div>

        <!-- Enrolled Modules -->
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Enrolled Modules</p>
            <p class="text-5xl font-semibold mt-3">@moduleCount</p>
        </div>

        <!-- Current Semester -->
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Current Semester</p>
            <p class="text-2xl font-semibold mt-3">@currentSemester</p>
        </div>

        <!-- CGPA -->
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Current CGPA</p>
            <p class="text-5xl font-semibold text-indigo-600 mt-3">@cgpa.ToString("0.00")</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <h2 class="text-2xl font-semibold mb-6">Quick Actions</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <a asp-action="BioData" class="glass rounded-3xl p-8 hover:shadow-xl transition text-center">
            <div class="text-5xl mb-4">👤</div>
            <p class="font-medium">Bio Data</p>
        </a>
        <a asp-action="Enrolment" class="glass rounded-3xl p-8 hover:shadow-xl transition text-center">
            <div class="text-5xl mb-4">📝</div>
            <p class="font-medium">Enrolment</p>
        </a>
        <a asp-action="Results" class="glass rounded-3xl p-8 hover:shadow-xl transition text-center">
            <div class="text-5xl mb-4">📊</div>
            <p class="font-medium">Results & CGPA</p>
        </a>
    </div>
</div>