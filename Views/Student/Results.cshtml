@{
    ViewData["Title"] = "My Results";
    var results = ViewBag.Results as List<CavendishACMISPortal.Models.Result>;
}
<div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-semibold mb-6">My Academic Results</h2>
    <table class="w-full glass rounded-3xl overflow-hidden">
        <thead class="bg-[#121e38] text-white">
            <tr>
                <th class="px-8 py-4 text-left">Module</th>
                <th class="px-8 py-4 text-left">Score</th>
                <th class="px-8 py-4 text-left">Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in results ?? new List<CavendishACMISPortal.Models.Result>())
            {
                <tr class="border-t">
                    <td class="px-8 py-4">@r.Module?.ModuleName</td>
                    <td class="px-8 py-4">@r.Score</td>
                    <td class="px-8 py-4">@r.Grade</td>
                </tr>
            }
        </tbody>
    </table>
</div>