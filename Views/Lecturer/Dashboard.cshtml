@{
    ViewData["Title"] = "Lecturer Dashboard";
    var lecturer = ViewBag.Lecturer as CavendishACMISPortal.Models.User;
}
<div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-semibold text-gray-900 dark:text-white">Welcome back, Dr. @lecturer?.FullName</h1>
    <p class="text-gray-500 dark:text-gray-400 mt-1">Lecturer Portal • Fine Arts Department</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Assigned Modules</p>
            <p class="text-5xl font-semibold text-indigo-600 mt-3">4</p>
        </div>
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Students Taught</p>
            <p class="text-5xl font-semibold text-emerald-600 mt-3">87</p>
        </div>
    </div>
</div>