@{
    ViewData["Title"] = "Lecturer Dashboard";
    var lecturer = ViewBag.Lecturer as CavendishACMISPortal.Models.User;
    var moduleStats = ViewBag.ModuleStats as List<CavendishACMISPortal.Models.ModuleStatViewModel>;
    int totalStudents = ViewBag.TotalStudentsTaught ?? 0;
}

<div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-semibold">Welcome back, @lecturer?.FullName</h1>
    <p class="text-gray-500 mt-1">@lecturer?.Department Department</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Total Students Taught</p>
            <p class="text-5xl font-semibold text-indigo-600 mt-3">@totalStudents</p>
        </div>
        <div class="glass rounded-3xl p-8">
            <p class="text-sm text-gray-500">Assigned Modules</p>
            <p class="text-5xl font-semibold mt-3">@moduleStats?.Count </p>
        </div>
    </div>

    <div class="mt-12">
        <h2 class="text-2xl font-semibold mb-6">My Modules</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @if (moduleStats?.Any() == true)
            {
                @foreach (var stat in moduleStats)
                {
                    var m = stat.ModuleAssignment.Module;
                    <div class="glass rounded-3xl p-8">
                        <div class="flex justify-between">
                            <div>
                                <h4 class="font-semibold">@m?.ModuleCode - @m?.ModuleName</h4>
                                <p class="text-sm text-gray-500">@m?.Credits Credits • @m?.Course?.CourseName</p>
                            </div>
                            <div class="text-right">
                                <span class="text-4xl font-bold text-indigo-600">@stat.StudentCount</span>
                                <p class="text-xs text-gray-500">Students</p>
                            </div>
                        </div>
                        <a asp-action="MyStudents" asp-route-moduleId="@m?.Id"
                           class="mt-6 inline-block bg-indigo-600 text-white px-6 py-3 rounded-2xl hover:bg-indigo-700">
                            View Students & Enter Results →
                        </a>
                    </div>
                }
            }
            else
            {
                <p class="text-gray-500 text-center py-12">No modules assigned yet. Contact Admin.</p>
            }
        </div>
    </div>
</div>