@{
    ViewData["Title"] = "Enter Result";
}
<div class="max-w-2xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Enter Student Result</h2>
    <div class="glass rounded-3xl p-8">
        <form asp-action="AddResult" method="post">
            <input type="hidden" name="ModuleId" value="@ViewBag.ModuleId" />

            <div>
                <label class="block text-sm font-medium mb-2">Student</label>
                <select name="UserId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    @foreach (var s in ViewBag.Students as List<CavendishACMISPortal.Models.User> ?? new List<CavendishACMISPortal.Models.User>())
                    {
                        <option value="@s.Id">@s.FullName (@s.Username)</option>
                    }
                </select>
            </div>

            <div class="mt-6">
                <label class="block text-sm font-medium mb-2">Score (0 - 100)</label>
                <input name="Score" type="number" step="0.1" min="0" max="100" 
                       class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>

            <div class="mt-6">
                <label class="block text-sm font-medium mb-2">Grade (A, B+, B, C+, C, D+, D, E, F)</label>
                <input name="Grade" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
            </div>

            <button type="submit" class="mt-10 w-full bg-green-600 text-white py-4 rounded-3xl font-semibold text-lg hover:bg-green-700 transition">
                Save Result
            </button>
        </form>
    </div>
</div>