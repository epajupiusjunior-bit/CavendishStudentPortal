@{
    ViewData["Title"] = "Enter Result";
    int moduleId = ViewBag.ModuleId ?? 0;
    var students = ViewBag.Students as List<CavendishACMISPortal.Models.User> ?? new List<CavendishACMISPortal.Models.User>();
}
<div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-semibold mb-8">Enter Student Result</h2>
    <div class="glass rounded-3xl p-10">
        <form asp-action="AddResult" method="post">
            <input type="hidden" name="ModuleId" value="@moduleId" />

            <div class="mb-8">
                <label class="block text-sm font-medium mb-2">Select Student</label>
                <select name="UserId" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required>
                    <option value="">-- Choose Student --</option>
                    @foreach (var s in students)
                    {
                        <option value="@s.Id">@s.FullName (@s.Username)</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-medium mb-2">CAT 1 (20%)</label>
                    <input name="CAT1" type="number" step="0.1" min="0" max="20" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">CAT 2 (20%)</label>
                    <input name="CAT2" type="number" step="0.1" min="0" max="20" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Final Exam (60%)</label>
                    <input name="FinalExam" type="number" step="0.1" min="0" max="60" class="w-full px-5 py-4 rounded-2xl border focus:border-[#4E93CC]" required />
                </div>
            </div>

            <button type="submit" class="mt-12 w-full bg-green-600 text-white py-5 rounded-3xl font-semibold hover:bg-green-700">
                Save Result
            </button>
        </form>
    </div>
</div>