<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cavendish ACMIS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <style>
        body { font-family: 'Inter', system-ui, sans-serif; }
        .navy { background: #0f172a; }
        .glass {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(16px);
        }
        .dark .glass {
        background: rgba(30, 41, 59, 0.95);
        }
        .nav-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        border-radius: 12px;
        color: rgba(255,255,255,0.85);
        text-decoration: none;
        transition: all 0.2s ease;
        }
        .nav-link:hover {
        background: rgba(255,255,255,0.15);
        color: white;
        transform: translateX(6px);
        }
        .nav-link.active {
        background: rgba(78, 147, 204, 0.35);
        color: white;
        }
    </style>
</head>
<body class="bg-[#f1f5f9] dark:bg-slate-900 text-gray-900 dark:text-gray-100">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <div id="sidebar" class="navy w-72 flex flex-col transition-all duration-300 shadow-2xl">
            <!-- Header -->
            <div class="p-6 border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <img src="/images/cavendish-logo.png" class="h-11" alt="Logo" />
                    <div>
                        <h1 class="text-xl font-semibold tracking-tight text-white">CAVENDISH</h1>
                        <p class="text-xs text-blue-300">UNIVERSITY UGANDA</p>
                    </div>
                </div>
                <button onclick="toggleSidebar()" class="text-white/70 hover:text-white p-2 rounded-xl hover:bg-white/10">
                    <i class="bi bi-list text-2xl"></i>
                </button>
            </div>

            <!-- Navigation -->
            <div class="flex-1 px-3 py-6 overflow-y-auto">
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a>
                    <a asp-controller="Admin" asp-action="Students" class="nav-link"><i class="bi bi-people"></i> <span>Students</span></a>
                    <a asp-controller="Admin" asp-action="AddStudent" class="nav-link"><i class="bi bi-person-plus"></i> <span>Add Student</span></a>
                    
                    <div class="px-4 py-2 mt-6 text-xs font-semibold text-blue-300 uppercase tracking-widest">Academics</div>
                    <a asp-controller="Admin" asp-action="Courses" class="nav-link"><i class="bi bi-book"></i> <span>Courses</span></a>
                    <a asp-controller="Admin" asp-action="Modules" class="nav-link"><i class="bi bi-journal-text"></i> <span>Modules</span></a>
                    <a asp-controller="Admin" asp-action="Results" class="nav-link"><i class="bi bi-clipboard-data"></i> <span>Results</span></a>
                }
                else if (Context.Session.GetString("Role") == "Lecturer")
                {
                    <a asp-controller="Lecturer" asp-action="Dashboard" class="nav-link"><i class="bi bi-speedometer2"></i> <span>Dashboard</span></a>
                    <a asp-controller="Lecturer" asp-action="MyModules" class="nav-link"><i class="bi bi-journal-text"></i> <span>My Modules</span></a>
                }
                else
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="nav-link"><i class="bi bi-house-door"></i> <span>Dashboard</span></a>
                    <a asp-controller="Student" asp-action="BioData" class="nav-link"><i class="bi bi-person"></i> <span>Bio Data</span></a>
                    <a asp-controller="Student" asp-action="Results" class="nav-link"><i class="bi bi-trophy"></i> <span>Results & CGPA</span></a>
                }
            </div>

            <!-- Footer -->
            <div class="p-4 border-t border-white/10">
                <div class="flex items-center gap-4">
                    <button onclick="toggleDarkMode()" class="flex-1 flex items-center justify-center gap-2 py-3 text-white/80 hover:text-white hover:bg-white/10 rounded-2xl transition">
                        <i class="bi bi-moon-stars"></i>
                        <span class="text-sm">Dark Mode</span>
                    </button>
                    <a asp-controller="Account" asp-action="Logout" class="flex-1 flex items-center justify-center gap-2 py-3 text-white/80 hover:text-white hover:bg-white/10 rounded-2xl transition">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="text-sm">Logout</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-8 overflow-auto">
            @RenderBody()
        </div>
    </div>

    <script>
        function toggleDarkMode() {
        document.documentElement.classList.toggle('dark');
        }

        function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        sidebar.classList.toggle('w-72');
        sidebar.classList.toggle('w-16');
        }
    </script>
</body>
</html>