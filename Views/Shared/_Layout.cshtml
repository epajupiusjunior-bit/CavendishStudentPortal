<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cavendish University Uganda</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
        --navy: #07111f;
        }

        body {
        font-family: 'DM Sans', sans-serif;
        background: var(--navy);
        color: #e2e8f0;
        min-height: 100vh;
        }

        .glass {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(20px);
        }

        .nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 12px;
        color: rgba(255,255,255,0.75);
        text-decoration: none;
        transition: all 0.2s ease;
        }

        .nav-link:hover {
        background: rgba(255,255,255,0.1);
        color: white;
        }

        .nav-link.active {
        background: rgba(14,90,170,0.3);
        color: white;
        }
        /* Background Orbs */
        .bg-orb {
        position: fixed;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        z-index: -1;
        }
    </style>
</head>
<body class="overflow-hidden">
    <!-- Background Effects -->
    <div class="bg-orb" style="width: 600px; height: 600px; background: rgba(14,90,170,0.15); top: -150px; right: -100px;"></div>
    <div class="bg-orb" style="width: 450px; height: 450px; background: rgba(22,163,74,0.12); bottom: -120px; left: -80px;"></div>

    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <div class="w-72 navy flex flex-col border-r border-white/10">
            <div class="p-6 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <img src="/images/cavendish-logo.png" class="h-11" alt="Logo" />
                    <div>
                        <h1 class="text-xl font-semibold text-white tracking-tight">CAVENDISH</h1>
                        <p class="text-xs text-blue-300">UNIVERSITY UGANDA</p>
                    </div>
                </div>
            </div>

            <div class="flex-1 px-3 py-6 overflow-y-auto">
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
                    <a asp-controller="Admin" asp-action="Students" class="nav-link"><i class="ti ti-users"></i> Students</a>
                    <a asp-controller="Admin" asp-action="AddStudent" class="nav-link"><i class="ti ti-user-plus"></i> Add Student</a>
                    <a asp-controller="Admin" asp-action="Courses" class="nav-link"><i class="ti ti-book"></i> Courses</a>
                    <a asp-controller="Admin" asp-action="Modules" class="nav-link"><i class="ti ti-book-2"></i> Modules</a>
                    <a asp-controller="Admin" asp-action="Results" class="nav-link"><i class="ti ti-clipboard-data"></i> Results</a>
                }
                else if (Context.Session.GetString("Role") == "Lecturer")
                {
                    <a asp-controller="Lecturer" asp-action="Dashboard" class="nav-link"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
                    <a asp-controller="Lecturer" asp-action="MyModules" class="nav-link"><i class="ti ti-book-2"></i> My Modules</a>
                }
                else
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="nav-link"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
                    <a asp-controller="Student" asp-action="BioData" class="nav-link"><i class="ti ti-user"></i> Bio Data</a>
                    <a asp-controller="Student" asp-action="Results" class="nav-link"><i class="ti ti-award"></i> Results & CGPA</a>
                }
            </div>

            <div class="p-4 border-t border-white/10">
                <button onclick="toggleDarkMode()" class="nav-link w-full">
                    <i class="ti ti-moon"></i> Dark Mode
                </button>
                <a asp-controller="Account" asp-action="Logout" class="nav-link w-full">
                    <i class="ti ti-logout"></i> Logout
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="flex-1 p-10 overflow-auto">
            @RenderBody()
        </div>
    </div>

    <script>
        function toggleDarkMode() {
        document.documentElement.classList.toggle('dark');
        }
    </script>
</body>
</html>